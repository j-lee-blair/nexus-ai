# Copy to .env.local for development. Never commit real keys.

# "mock" serves made-up movies for UI development (refused on Vercel production).
NEXUS_DATA_SOURCE=mock
# Simulated provider latency for first lookups in mock mode, in milliseconds.
NEXUS_MOCK_LATENCY_MS=700

# --- Watchmode (ADR 0002). Live calls stay off unless WATCHMODE_LIVE_CALLS=on. ---
# Only needed to record fixtures (npm run record-fixtures) or on the deployed app.
WATCHMODE_API_KEY=
# "on" allows real Watchmode calls. Leave off in development: fixtures answer instead.
WATCHMODE_LIVE_CALLS=off
# "on" stops all Watchmode calls immediately, whatever else is set.
WATCHMODE_KILL_SWITCH=off
WATCHMODE_DAILY_CREDIT_CAP=60
WATCHMODE_MONTHLY_CREDIT_CAP=2000

# --- Upstash Redis (cache and credit counter). Leave empty locally to use memory. ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
